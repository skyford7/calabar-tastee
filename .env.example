# ── Supabase (Project Settings → API) ───────────────────────────────────────
# Browser-safe. Either the legacy "anon" key or the new "publishable" key works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — used by /api/admin/users to create and manage staff logins.
# Either the legacy "service_role" key or the new "secret" key works.
# Never prefix this with NEXT_PUBLIC_ or VITE_.
SUPABASE_SECRET_KEY=

# ── Staff portal hosting ─────────────────────────────────────────────────────
# Phase 1: leave empty → portal lives at https://calabartastee.com/admin
# Phase 2: set to https://admin.calabartastee.com → /admin on the main site
#          redirects there and the portal is served at the subdomain root.
NEXT_PUBLIC_ADMIN_ORIGIN=

# Cookie domain for the login session. Leave empty for localhost/preview URLs.
# Set to .calabartastee.com in Production so the session is shared between
# calabartastee.com and admin.calabartastee.com.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
